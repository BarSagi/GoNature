<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/19"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.DeptManagerSavedReportsPanelController"
	style="-fx-background-color: #f4f7f6;">

	<top>
		<HBox alignment="CENTER_LEFT" style="-fx-padding: 15;">
			<Label text="Saved Reports"
				style="-fx-font-size: 22px; -fx-font-weight: bold;" />

			<Region HBox.hgrow="ALWAYS" />

			<Button onAction="#refreshReports"
				style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
				<graphic>
					<javafx.scene.shape.SVGPath
						content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
						fill="#34495e" scaleX="1.3" scaleY="1.3" />
				</graphic>
			</Button>
		</HBox>
	</top>

	<center>
		<TableView fx:id="reportsTable">
			<columns>
				<TableColumn fx:id="typeColumn" text="Type"
					prefWidth="150" />
				<TableColumn fx:id="monthColumn" text="Month"
					prefWidth="80" />
				<TableColumn fx:id="yearColumn" text="Year"
					prefWidth="80" />
				<TableColumn fx:id="dateColumn" text="Created At"
					prefWidth="180" />
			</columns>
		</TableView>
	</center>

</BorderPane>