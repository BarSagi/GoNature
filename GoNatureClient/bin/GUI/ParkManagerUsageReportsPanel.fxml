<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.?>
<?import javafx.scene.layout.?>

<VBox alignment="CENTER" spacing="15.0"
	xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.ParkManagerUsageReportsPanelController"
	style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;">

	<Label text="Usage Heatmap - Days of Month"
		style="-fx-font-size: 22px; -fx-font-weight: bold;" />

	<HBox spacing="10" alignment="CENTER">

		<Label text="Month:" />
		<ComboBox fx:id="monthCombo" />

		<Label text="Year:" />
		<ComboBox fx:id="yearCombo" />

		<Button text="Generate" onAction="#generateReport"
			prefHeight="40.0" prefWidth="160.0"
			style="-fx-background-color: #2980b9; -fx-text-fill: white;" />

		<Button fx:id="saveReportBtn" text="Save Report"
			onAction="#saveReport"
			style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
	</HBox>

	<VBox fx:id="legendBox" alignment="CENTER" />

	<GridPane fx:id="heatmapGrid" hgap="5" vgap="5"
		alignment="CENTER" />

</VBox>