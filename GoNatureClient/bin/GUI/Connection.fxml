<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="320.0" prefWidth="350.0"
	spacing="20.0"
	style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-radius: 8;"
	xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.ConnectionController">
	<children>

		<Label text="GoNature" textFill="#2E4053">
			<font>
				<Font name="System Bold" size="22.0" />
			</font>
			<VBox.margin>
				<Insets bottom="10.0" />
			</VBox.margin>
		</Label>

		<VBox spacing="8.0">
			<children>
				<Label text="Server IP Address:" textFill="#7f8c8d">
					<font>
						<Font name="System Bold" size="13.0" />
					</font>
				</Label>
				<TextField fx:id="txtIP" promptText="e.g. 127.0.0.1"
					style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;" />
			</children>
			<VBox.margin>
				<Insets left="25.0" right="25.0" />
			</VBox.margin>
		</VBox>

		<VBox spacing="8.0">
			<children>
				<Label text="Server Port:" textFill="#7f8c8d">
					<font>
						<Font name="System Bold" size="13.0" />
					</font>
				</Label>
				<TextField fx:id="txtPort" promptText="e.g. 5555"
					style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 8;" />
			</children>
			<VBox.margin>
				<Insets left="25.0" right="25.0" />
			</VBox.margin>
		</VBox>

		<Label fx:id="errorLabel" textFill="#e74c3c" wrapText="true">
			<font>
				<Font name="System Bold" size="12.0" />
			</font>
		</Label>

		<HBox alignment="CENTER" spacing="20.0">
			<children>
				<Button mnemonicParsing="false" onAction="#connectToServer"
					prefWidth="120.0"
					style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-cursor: hand;"
					text="Connect" />
				<Button mnemonicParsing="false" onAction="#exit"
					prefWidth="120.0"
					style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-cursor: hand;"
					text="Exit" />
			</children>
			<VBox.margin>
				<Insets top="10.0" />
			</VBox.margin>
		</HBox>
	</children>

	<padding>
		<Insets bottom="30.0" left="20.0" right="20.0" top="30.0" />
	</padding>

	<effect>
		<DropShadow blurType="GAUSSIAN" color="#00000033"
			height="30.0" radius="14.5" width="30.0" />
	</effect>
</VBox>