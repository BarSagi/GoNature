<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="450.0"
	spacing="20.0" style="-fx-background-color: #f4f4f4;"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.VisitorMyDetailsPanelController">

	<children>
		<VBox alignment="CENTER" maxWidth="500.0" spacing="20.0"
			style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 5); -fx-padding: 30;">
			<children>

				<Label text="My Details" textFill="#2c3e50">
					<font>
						<Font name="System Bold" size="24.0" />
					</font>
					<VBox.margin>
						<Insets bottom="10.0" />
					</VBox.margin>
				</Label>

				<GridPane hgap="15.0" vgap="15.0">
					<children>
						<Label text="First Name:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="0" />
						<TextField fx:id="firstNameField" prefWidth="220.0"
							style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"
							GridPane.columnIndex="1" GridPane.rowIndex="0" />

						<Label text="Last Name:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="1" />
						<TextField fx:id="lastNameField" prefWidth="220.0"
							style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"
							GridPane.columnIndex="1" GridPane.rowIndex="1" />

						<Label text="Visitor Type:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="2" />
						<TextField fx:id="visitorTypeField" editable="false"
							prefWidth="220.0"
							style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #d5d8dc; -fx-background-color: #f8f9f9;"
							GridPane.columnIndex="1" GridPane.rowIndex="2" />

						<Label text="Phone:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="3" />
						<TextField fx:id="phoneField" prefWidth="220.0"
							style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"
							GridPane.columnIndex="1" GridPane.rowIndex="3" />

						<Label text="Email:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="4" />
						<TextField fx:id="emailField" prefWidth="220.0"
							style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"
							GridPane.columnIndex="1" GridPane.rowIndex="4" />

						<Label text="Credit Card:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="5" />
						<TextField fx:id="creditCardField" prefWidth="220.0"
							style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"
							GridPane.columnIndex="1" GridPane.rowIndex="5" />
					</children>
				</GridPane>

				<Label fx:id="statusLabel" text="" textFill="#e74c3c">
					<font>
						<Font name="System Bold" size="12.0" />
					</font>
				</Label>

				<HBox alignment="CENTER" spacing="20.0">
					<children>
						<Button text="Save Changes" onAction="#saveChanges"
							prefWidth="180.0"
							style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8;" />
					</children>
					<VBox.margin>
						<Insets top="10.0" />
					</VBox.margin>
				</HBox>
				<Button text="back" onAction="#goBack" prefWidth="120.0"
						prefHeight="35.0"
						style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
				
			</children>
		</VBox>
	</children>
</VBox>