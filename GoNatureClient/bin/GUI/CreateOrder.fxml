<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="450.0"
	spacing="20.0" style="-fx-background-color: #f4f4f4;"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.CreateOrderController">
	<children>
		<VBox alignment="CENTER" maxWidth="400.0" spacing="15.0"
			style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 5); -fx-padding: 30;">
			<children>
				<Label text="Create New Order" textFill="#2c3e50">
					<font>
						<Font name="System Bold" size="24.0" />
					</font>
					<VBox.margin>
						<Insets bottom="10.0" />
					</VBox.margin>
				</Label>

				<GridPane hgap="15.0" vgap="15.0">
					<children>
						<Label text="Select Park:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="0" />
						<ComboBox fx:id="parkComboBox" prefWidth="200.0"
							promptText="Choose a Park..." style="-fx-background-radius: 5;"
							GridPane.columnIndex="1" GridPane.rowIndex="0" />

						<Label text="Date:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="1" />
						<DatePicker fx:id="datePicker" prefWidth="200.0"
							promptText="Select Date" style="-fx-background-radius: 5;"
							GridPane.columnIndex="1" GridPane.rowIndex="1" />

						<Label text="Time:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="2" />
						<ComboBox fx:id="timeComboBox" prefWidth="200.0"
							promptText="Select Time..." style="-fx-background-radius: 5;"
							GridPane.columnIndex="1" GridPane.rowIndex="2" />

						<Label text="Visitors:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="3" />
						<TextField fx:id="visitorsTextField" prefWidth="200.0"
							promptText="Number of people"
							style="-fx-background-radius: 5; -fx-padding: 5;"
							GridPane.columnIndex="1" GridPane.rowIndex="3" />

						<Label text="Email:" textFill="#7f8c8d"
							GridPane.columnIndex="0" GridPane.rowIndex="4" />
						<TextField fx:id="emailTextField" prefWidth="200.0"
							promptText="example@mail.com"
							style="-fx-background-radius: 5; -fx-padding: 5;"
							GridPane.columnIndex="1" GridPane.rowIndex="4" />
					</children>
				</GridPane>

				<Label fx:id="errorLabel" textFill="#e74c3c" visible="false">
					<font>
						<Font name="System Italic" size="12.0" />
					</font>
				</Label>

				<HBox alignment="CENTER" spacing="20.0">
					<children>
						<Button fx:id="backButton" mnemonicParsing="false"
							onAction="#goBack" prefWidth="100.0"
							style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8;"
							text="Back" />
						<Button fx:id="createOrderButton" mnemonicParsing="false"
							onAction="#submitOrder" prefWidth="150.0"
							style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8;"
							text="Submit Order" />
					</children>
					<VBox.margin>
						<Insets top="10.0" />
					</VBox.margin>
				</HBox>
			</children>
		</VBox>
	</children>
</VBox>