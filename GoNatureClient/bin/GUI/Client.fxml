<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
	fx:controller="GUI.ClientController">

	<Button text="Get Orders" onAction="#getOrders" />

	<TextField fx:id="orderNumberField" promptText="Order Number" />

	<TextField fx:id="orderDateField" promptText="yyyy-mm-dd" />

	<TextField fx:id="visitorsField" promptText="Visitors" />

	<Button text="Update Order" onAction="#updateOrder" />

	<TextArea fx:id="ordersArea" prefHeight="300" />

	<Button text="Exit" onAction="#exit" />

</VBox>