<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="450.0"
	spacing="20.0" style="-fx-background-color: #f4f4f4;"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.ServiceRepSearchEmployeePanelController">

	<children>
		<VBox alignment="CENTER" maxWidth="500.0" spacing="20.0"
			style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 5); -fx-padding: 30;">
			<children>

				<Label text="Search Employee" textFill="#2c3e50">
					<font>
						<Font name="System Bold" size="24.0" />
					</font>
				</Label>

				<HBox alignment="CENTER" spacing="10.0">
					<TextField fx:id="employeeIdField" promptText="Enter Employee ID"
						prefWidth="220.0" />
					<Button text="Search" onAction="#searchEmployee"
						style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
				</HBox>

				<GridPane hgap="15.0" vgap="15.0">
					<children>
						<Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
						<TextField fx:id="firstNameField" editable="false"
							GridPane.columnIndex="1" GridPane.rowIndex="0" />

						<Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
						<TextField fx:id="lastNameField" editable="false"
							GridPane.columnIndex="1" GridPane.rowIndex="1" />

						<Label text="Employee ID:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
						<TextField fx:id="employeeIdResultField" editable="false"
							GridPane.columnIndex="1" GridPane.rowIndex="2" />

						<Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
						<TextField fx:id="emailField" editable="false"
							GridPane.columnIndex="1" GridPane.rowIndex="3" />

						<Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
						<TextField fx:id="roleField" editable="false"
							GridPane.columnIndex="1" GridPane.rowIndex="4" />

						<Label text="Affiliation:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
						<TextField fx:id="affiliationField" editable="false"
							GridPane.columnIndex="1" GridPane.rowIndex="5" />
					</children>
				</GridPane>

				<Label fx:id="statusLabel" text=""
					style="-fx-text-fill: #e74c3c; -fx-font-size: 12px; -fx-font-weight: bold;" />

			</children>
		</VBox>
	</children>
</VBox>