<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="600.0"
	style="-fx-background-color: #f4f6f7;"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI_Visitor.NewVisitorOrderController">
	<children>
		<VBox alignment="TOP_CENTER" layoutX="50.0" layoutY="30.0"
			prefWidth="500.0" spacing="20.0"
			style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;">
			<effect>
				<DropShadow color="#00000033" radius="10.0" />
			</effect>
			<children>
				<Label text="New Visitor Registration &amp; Order"
					textFill="#2c3e50">
					<font>
						<Font name="System Bold" size="24.0" />
					</font>
				</Label>
				<Label
					text="Please fill in your details to complete your first order."
					textFill="#7f8c8d" />

				<Label fx:id="errorLabel"
					text="Error messages will appear here" textFill="#e74c3c"
					visible="false">
					<font>
						<Font name="System Bold" size="13.0" />
					</font>
				</Label>

				<VBox spacing="10.0"
					style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 15;">
					<children>
						<Label text="1. Personal Details" textFill="#34495e">
							<font>
								<Font name="System Bold" size="16.0" />
							</font>
						</Label>
						<GridPane hgap="15.0" vgap="15.0">
							<children>
								<TextField fx:id="idField" promptText="ID Number"
									GridPane.columnIndex="0" GridPane.rowIndex="0" />
								<TextField fx:id="firstNameField"
									promptText="First Name" GridPane.columnIndex="1"
									GridPane.rowIndex="0" />
								<TextField fx:id="lastNameField"
									promptText="Last Name" GridPane.columnIndex="0"
									GridPane.rowIndex="1" />
								<TextField fx:id="emailField"
									promptText="Email Address" GridPane.columnIndex="1"
									GridPane.rowIndex="1" />
								<TextField fx:id="phoneField"
									promptText="Phone Number" GridPane.columnIndex="0"
									GridPane.rowIndex="2" />
							</children>
						</GridPane>
					</children>
				</VBox>

				<VBox spacing="10.0"
					style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 15;">
					<children>
						<Label text="2. Visit Details" textFill="#34495e">
							<font>
								<Font name="System Bold" size="16.0" />
							</font>
						</Label>
						<GridPane hgap="15.0" vgap="15.0">
							<children>
								<ComboBox fx:id="parkComboBox" prefWidth="200.0"
									promptText="Select Park" GridPane.columnIndex="0"
									GridPane.rowIndex="0" />
								<TextField fx:id="visitorsCountField"
									promptText="Number of Visitors" GridPane.columnIndex="1"
									GridPane.rowIndex="0" />
								<DatePicker fx:id="datePicker" prefWidth="200.0"
									promptText="Select Date" GridPane.columnIndex="0"
									GridPane.rowIndex="1" />
								<ComboBox fx:id="timeComboBox" prefWidth="200.0"
									promptText="Select Time" GridPane.columnIndex="1"
									GridPane.rowIndex="1" />
							</children>
						</GridPane>
					</children>
				</VBox>

				<HBox alignment="CENTER" spacing="20.0" VBox.vgrow="NEVER">
					<children>
						<Button mnemonicParsing="false" onAction="#goBack"
							prefHeight="40.0" prefWidth="100.0"
							style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5;"
							text="Back">
							<font>
								<Font name="System Bold" size="14.0" />
							</font>
						</Button>
						<Button mnemonicParsing="false"
							onAction="#submitRegistrationAndOrder" prefHeight="40.0"
							prefWidth="250.0"
							style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 5;"
							text="Complete Registration &amp; Order">
							<font>
								<Font name="System Bold" size="14.0" />
							</font>
						</Button>
					</children>
					<VBox.margin>
						<Insets top="10.0" />
					</VBox.margin>
				</HBox>
			</children>
		</VBox>
	</children>
</AnchorPane>