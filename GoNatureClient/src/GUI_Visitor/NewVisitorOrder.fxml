<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="600.0"
	style="-fx-background-color: #f4f6f7;"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI_Visitor.NewVisitorOrderController">
	<children>
		<ScrollPane fitToWidth="true"
			style="-fx-background: #f4f6f7; -fx-background-color: transparent; -fx-border-color: transparent;"
			AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
			AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
			<content>
				<StackPane>
					<children>
						<VBox alignment="TOP_CENTER" maxWidth="500.0" spacing="20.0"
							style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;">
							<effect>
								<DropShadow color="#00000033" radius="10.0" />
							</effect>
							<StackPane.margin>
								<Insets bottom="30.0" top="30.0" />
							</StackPane.margin>
							<children>
								<Label text="New Visitor Registration &amp; Order"
									textFill="#2c3e50">
									<font>
										<Font name="System Bold" size="24.0" />
									</font>
								</Label>
								<Label
									text="Please fill in your details to complete your first order."
									textFill="#7f8c8d" />

								<Label fx:id="errorLabel"
									text="Error messages will appear here" textFill="#e74c3c"
									visible="false">
									<font>
										<Font name="System Bold" size="13.0" />
									</font>
								</Label>

								<VBox spacing="15.0"
									style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 15;">
									<children>
										<Label text="1. Personal Details" textFill="#34495e">
											<font>
												<Font name="System Bold" size="16.0" />
											</font>
										</Label>
										<GridPane hgap="15.0" vgap="15.0">
											<columnConstraints>
												<ColumnConstraints hgrow="SOMETIMES"
													minWidth="10.0" percentWidth="50.0" />
												<ColumnConstraints hgrow="SOMETIMES"
													minWidth="10.0" percentWidth="50.0" />
											</columnConstraints>
											<children>
												<TextField fx:id="firstNameField"
													prefHeight="35.0" promptText="First Name"
													GridPane.columnIndex="0" GridPane.rowIndex="0" />
												<TextField fx:id="lastNameField" prefHeight="35.0"
													promptText="Last Name" GridPane.columnIndex="1"
													GridPane.rowIndex="0" />
												<TextField fx:id="idField" prefHeight="35.0"
													promptText="ID Number" GridPane.columnIndex="0"
													GridPane.rowIndex="1" />
												<TextField fx:id="phoneField" prefHeight="35.0"
													promptText="Phone Number" GridPane.columnIndex="1"
													GridPane.rowIndex="1" />
												<TextField fx:id="emailField" prefHeight="35.0"
													promptText="Email Address" GridPane.columnIndex="0"
													GridPane.columnSpan="2" GridPane.rowIndex="2" />
											</children>
										</GridPane>
									</children>
								</VBox>

								<VBox spacing="15.0"
									style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 15;">
									<children>
										<Label text="2. Visit Details" textFill="#34495e">
											<font>
												<Font name="System Bold" size="16.0" />
											</font>
										</Label>
										<GridPane hgap="15.0" vgap="15.0">
											<columnConstraints>
												<ColumnConstraints hgrow="SOMETIMES"
													minWidth="10.0" percentWidth="50.0" />
												<ColumnConstraints hgrow="SOMETIMES"
													minWidth="10.0" percentWidth="50.0" />
											</columnConstraints>
											<children>
												<VBox spacing="5.0" GridPane.columnIndex="0"
													GridPane.rowIndex="0">
													<children>
														<Label
															style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"
															text="Select Park:" />
														<ComboBox fx:id="parkComboBox"
															maxWidth="Infinity" prefHeight="35.0" />
													</children>
												</VBox>
												<VBox spacing="5.0" GridPane.columnIndex="1"
													GridPane.rowIndex="0">
													<children>
														<Label
															style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"
															text="Number of Visitors:" />
														<Spinner fx:id="visitorsSpinner"
															maxWidth="Infinity" prefHeight="35.0" />
													</children>
												</VBox>
												<VBox spacing="5.0" GridPane.columnIndex="0"
													GridPane.rowIndex="1">
													<children>
														<Label
															style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"
															text="Select Date:" />
														<DatePicker fx:id="datePicker"
															maxWidth="Infinity" prefHeight="35.0" />
													</children>
												</VBox>
												<VBox spacing="5.0" GridPane.columnIndex="1"
													GridPane.rowIndex="1">
													<children>
														<Label
															style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"
															text="Select Time:" />
														<ComboBox fx:id="timeComboBox"
															maxWidth="Infinity" prefHeight="35.0" />
													</children>
												</VBox>
												<VBox spacing="5.0" GridPane.columnIndex="0"
													GridPane.columnSpan="2" GridPane.rowIndex="2">
													<children>
														<Label
															style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"
															text="Payment Method:" />
														<ComboBox fx:id="paymentComboBox"
															maxWidth="Infinity" prefHeight="35.0" />
													</children>
												</VBox>
											</children>
										</GridPane>
									</children>
								</VBox>

								<HBox alignment="CENTER" spacing="20.0" VBox.vgrow="NEVER">
									<children>
										<Button mnemonicParsing="false" onAction="#goBack"
											prefHeight="45.0" prefWidth="120.0"
											style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
											text="Back">
											<font>
												<Font name="System Bold" size="14.0" />
											</font>
										</Button>
										<Button mnemonicParsing="false"
											onAction="#submitRegistrationAndOrder" prefHeight="45.0"
											prefWidth="250.0"
											style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
											text="Complete Registration &amp; Order">
											<font>
												<Font name="System Bold" size="14.0" />
											</font>
										</Button>
									</children>
									<VBox.margin>
										<Insets top="15.0" />
									</VBox.margin>
								</HBox>
							</children>
						</VBox>
					</children>
				</StackPane>
			</content>
		</ScrollPane>
	</children>
</AnchorPane>