<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox alignment="TOP_CENTER" spacing="20.0"
	style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #bdc3c7; -fx-border-radius: 8;"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI_Visitor.EditOrderController">

	<padding>
		<Insets top="30.0" right="40.0" bottom="30.0" left="40.0" />
	</padding>

	<Label text="Edit Your Order"
		style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
	<Label fx:id="orderIdLabel" text="Order ID: #-----"
		style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />

	<GridPane vgap="15.0" hgap="15.0" alignment="CENTER">
		<columnConstraints>
			<ColumnConstraints halignment="RIGHT"
				minWidth="120.0" />
			<ColumnConstraints halignment="LEFT"
				minWidth="200.0" />
		</columnConstraints>

		<Label text="Date:" GridPane.columnIndex="0"
			GridPane.rowIndex="0"
			style="-fx-font-size: 14px; -fx-font-weight: bold;" />
		<DatePicker fx:id="datePicker" prefWidth="200.0"
			GridPane.columnIndex="1" GridPane.rowIndex="0" />

		<Label text="Time:" GridPane.columnIndex="0"
			GridPane.rowIndex="1"
			style="-fx-font-size: 14px; -fx-font-weight: bold;" />
		<ComboBox fx:id="timeComboBox" prefWidth="200.0"
			GridPane.columnIndex="1" GridPane.rowIndex="1" />

		<Label text="Number of Visitors:" GridPane.columnIndex="0"
			GridPane.rowIndex="2"
			style="-fx-font-size: 14px; -fx-font-weight: bold;" />
		<TextField fx:id="visitorsField" prefWidth="200.0"
			promptText="e.g., 4" GridPane.columnIndex="1" GridPane.rowIndex="2" />

	</GridPane>

	<Label fx:id="statusLabel" text=""
		style="-fx-text-fill: red; -fx-font-size: 12px;" />

	<HBox spacing="20.0" alignment="CENTER">
		<Button text="Cancel" onAction="#cancelEdit" prefWidth="120.0"
			prefHeight="35.0"
			style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

		<Button text="Save Changes" onAction="#saveOrder"
			prefWidth="150.0" prefHeight="35.0"
			style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
	</HBox>

</VBox>