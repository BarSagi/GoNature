<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="850.0"
	style="-fx-background-color: #f4f7f6;"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI_Visitor.VisitorOrdersScreenController">

	<left>
		<VBox alignment="TOP_CENTER" prefWidth="260.0" spacing="12.0"
			style="-fx-background-color: #1e8449; -fx-border-color: #145a32; -fx-border-width: 0 2px 0 0;">
			<padding>
				<Insets top="40.0" right="15.0" bottom="20.0" left="15.0" />
			</padding>

			<Label text="GoNature"
				style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" />
			<Label text="Visitor Dashboard"
				style="-fx-font-size: 12px; -fx-text-fill: #a9dfbf; -fx-font-style: italic;">
				<VBox.margin>
					<Insets bottom="25.0" />
				</VBox.margin>
			</Label>

			<VBox spacing="4.0" alignment="CENTER"
				style="-fx-background-color: #145a32; -fx-background-radius: 8; -fx-padding: 10;">
				<Label fx:id="welcomeLabel" text="Hello, Visitor!"
					style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"
					wrapText="true" textAlignment="CENTER" />
				<Label text="Role: Registered Visitor"
					style="-fx-font-size: 12px; -fx-text-fill: #bdc3c7;" />
				<VBox.margin>
					<Insets bottom="20.0" />
				</VBox.margin>
			</VBox>

			<Button text="Create New Order" onAction="#createNewOrder"
				prefHeight="45.0" prefWidth="230.0"
				style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-alignment: CENTER; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />

			<VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
				<Button text="Logout" onAction="#logout" prefHeight="38.0"
					prefWidth="130.0"
					style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
			</VBox>
		</VBox>
	</left>

	<center>
		<VBox spacing="15.0" BorderPane.alignment="CENTER">
			<padding>
				<Insets top="40.0" right="40.0" bottom="40.0" left="40.0" />
			</padding>

			<Label text="Your Recent Orders"
				style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
			<Label text="View and manage your upcoming visits below."
				style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />

			<TableView fx:id="ordersTable"
				style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 14px;"
				VBox.vgrow="ALWAYS">
				<columns>
					<TableColumn fx:id="colDate" prefWidth="100.0"
						text="Date" />
					<TableColumn fx:id="colTime" prefWidth="90.0"
						text="Time" />
					<TableColumn fx:id="colId" prefWidth="80.0"
						text="Order ID" />
					<TableColumn fx:id="colVisitors" prefWidth="80.0"
						text="Visitors" />
					<TableColumn fx:id="colType" prefWidth="110.0"
						text="Type" />
					<TableColumn fx:id="colStatus" prefWidth="100.0"
						text="Status" />
				</columns>
				<columnResizePolicy>
					<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
				</columnResizePolicy>
			</TableView>
		</VBox>
	</center>

</BorderPane>