<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="mainBorderPane" prefHeight="720.0"
	prefWidth="1100.0" style="-fx-background-color: #f4f7f6;"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI_Visitor.VisitorOrdersScreenController">

	<left>
		<VBox alignment="TOP_CENTER" prefWidth="280.0" spacing="15.0"
			style="-fx-background-color: #1e8449; -fx-border-color: #145a32; -fx-border-width: 0 2px 0 0;">
			<padding>
				<Insets top="40.0" right="15.0" bottom="20.0" left="15.0" />
			</padding>

			<Label text="GoNature"
				style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" />
			<Label text="Visitor Dashboard"
				style="-fx-font-size: 12px; -fx-text-fill: #a9dfbf; -fx-font-style: italic;">
				<VBox.margin>
					<Insets bottom="15.0" />
				</VBox.margin>
			</Label>

			<VBox spacing="4.0" alignment="CENTER"
				style="-fx-background-color: #145a32; -fx-background-radius: 8; -fx-padding: 10;">
				<Label fx:id="welcomeLabel" text="Hello, Visitor!"
					style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"
					wrapText="true" textAlignment="CENTER" />
				<Label fx:id="roleLabel" text="Role: Loading..."
					style="-fx-font-size: 12px; -fx-text-fill: #bdc3c7;" />
				<VBox.margin>
					<Insets bottom="10.0" />
				</VBox.margin>
			</VBox>

			<Button text="Create New Order" onAction="#createNewOrder"
				prefHeight="45.0" prefWidth="240.0"
				style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-alignment: CENTER; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />

			<VBox spacing="10.0" alignment="CENTER"
				style="-fx-padding: 10 0 0 0;">
				<Label text="Selected Order Actions:"
					style="-fx-text-fill: #a9dfbf; -fx-font-size: 12px; -fx-font-weight: bold;" />

				<Button text="Show Ticket" onAction="#showTicket"
					prefHeight="40.0" prefWidth="240.0"
					style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

				<Button text="Edit Selected Order" onAction="#editOrder"
					prefHeight="40.0" prefWidth="240.0"
					style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

				<Button text="Confirm Selected Order"
					onAction="#confirmOrder" prefHeight="40.0" prefWidth="240.0"
					style="-fx-background-color: #229954; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

				<Button text="Cancel Selected Order" onAction="#cancelOrder"
					prefHeight="40.0" prefWidth="240.0"
					style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

				<Button text="Report Exit" onAction="#reportExit"
					prefHeight="40.0" prefWidth="240.0"
					style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
			</VBox>

			<VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
				<Button text="Logout" onAction="#logout" prefHeight="38.0"
					prefWidth="130.0"
					style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
			</VBox>
		</VBox>
	</left>

	<center>
		<VBox spacing="15.0" BorderPane.alignment="CENTER">
			<padding>
				<Insets top="40.0" right="40.0" bottom="40.0" left="40.0" />
			</padding>

			<HBox alignment="CENTER_LEFT">
				<VBox spacing="2.0">
					<Label text="Your Recent Orders"
						style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
					<Label
						text="Select an order from the list below to use the actions in the menu, or double-click to view your ticket."
						style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
				</VBox>

				<Region HBox.hgrow="ALWAYS" />

				<Button onAction="#refreshOrders"
					style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
					<graphic>
						<javafx.scene.shape.SVGPath
							content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
							fill="#34495e" scaleX="1.3" scaleY="1.3" />
					</graphic>
					<HBox.margin>
						<Insets right="5.0" />
					</HBox.margin>
				</Button>
			</HBox>

			<TableView fx:id="ordersTable"
				style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 15px;"
				VBox.vgrow="ALWAYS">
				<columns>
					<TableColumn fx:id="colPark" prefWidth="120.0"
						text="Park Name" />
					<TableColumn fx:id="colDate" prefWidth="110.0"
						text="Date" />
					<TableColumn fx:id="colTime" prefWidth="100.0"
						text="Time" />
					<TableColumn fx:id="colId" prefWidth="90.0"
						text="Order ID" />
					<TableColumn fx:id="colVisitors" prefWidth="90.0"
						text="Visitors" />
					<TableColumn fx:id="colType" prefWidth="130.0"
						text="Type" />
					<TableColumn fx:id="colStatus" prefWidth="120.0"
						text="Status" />
				</columns>
				<columnResizePolicy>
					<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
				</columnResizePolicy>
			</TableView>
		</VBox>
	</center>

</BorderPane>