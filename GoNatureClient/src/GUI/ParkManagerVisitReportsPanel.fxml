<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.?>
<?import javafx.scene.layout.?>
<?import javafx.scene.chart.PieChart?>

<VBox alignment="CENTER" spacing="15.0"
	style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;"
	xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.ParkManagerVisitReportsPanelController">

	<Label text="Visit Reports"
		style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

	<HBox spacing="10" alignment="CENTER">

		<ComboBox fx:id="monthCombo" promptText="Month" />

		<ComboBox fx:id="yearCombo" promptText="Year" />

		<Button text="Generate" onAction="#generateReport"
			style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
	</HBox>

	<Label fx:id="noDataLabel"
		text="No data available for the selected period"
		style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"
		visible="false" managed="false" />
	<VBox fx:id="reportContainer" alignment="CENTER" spacing="10">

		<Label fx:id="totalLabel" text="Total visitors: -"
			style="-fx-font-size: 14px; -fx-font-weight: bold;" />

		<PieChart fx:id="pieChart" prefHeight="300" prefWidth="400" />

	</VBox>

	<Button fx:id="saveReportBtn" text="Save Report"
		onAction="#saveReport"
		style="-fx-background-color: #27ae60; -fx-text-fill: white;" />

</VBox>