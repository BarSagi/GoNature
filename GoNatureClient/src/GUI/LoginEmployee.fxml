<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="450.0"
	spacing="15.0" style="-fx-background-color: #f4f7f6;"
	xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.LoginEmployeeController">

	<padding>
		<Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
	</padding>

	<Label text="Employee Login"
		style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

	<Label text="Enter your credentials to access the portal"
		style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;">
		<VBox.margin>
			<Insets bottom="10.0" />
		</VBox.margin>
	</Label>

	<TextField fx:id="usernameField" maxWidth="250.0"
		prefHeight="40.0" promptText="Username"
		style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-font-size: 15px; -fx-alignment: center;" />

	<PasswordField fx:id="passwordField" maxWidth="250.0"
		prefHeight="40.0" promptText="Password"
		style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-font-size: 15px; -fx-alignment: center;" />

	<Button text="Sign In" onAction="#loginEmployee"
		prefHeight="40.0" prefWidth="250.0"
		style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15px;">
		<VBox.margin>
			<Insets top="10.0" />
		</VBox.margin>
	</Button>
	<Label fx:id="errorLabel" text=""
		style="-fx-text-fill: red; -fx-font-size: 14px;" />

	<Button text="Back" onAction="#goBack" prefHeight="35.0"
		prefWidth="100.0"
		style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 13px;" />

</VBox>