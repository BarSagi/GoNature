<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="GUI.ClientController"
      spacing="12"
      prefWidth="420"
      alignment="TOP_CENTER"
      style="-fx-background-color: #f4f4f4;">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Title -->
    <Label text="Order Management System"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <Separator/>

    <!-- ACTIONS -->
    <VBox spacing="10" alignment="CENTER">

        <Label text="Actions"
               style="-fx-font-size: 14px; -fx-font-weight: bold;" />

        <!-- Centered buttons -->
        <HBox spacing="15" alignment="CENTER">

            <Button text="Get Orders"
                    onAction="#getOrders"
                    prefWidth="180"
                    minWidth="180"
                    maxWidth="180"/>

            <Button text="Update Order"
                    onAction="#updateOrder"
                    prefWidth="180"
                    minWidth="180"
                    maxWidth="180"/>

        </HBox>

        <TextField fx:id="orderNumberField"
                   prefWidth="380"
                   promptText="Order Number" />

        <TextField fx:id="orderDateField"
                   prefWidth="380"
                   promptText="Date (yyyy-mm-dd)" />

        <TextField fx:id="visitorsField"
                   prefWidth="380"
                   promptText="Number of Visitors" />

    </VBox>

    <Separator/>

    <!-- OUTPUT -->
    <Label text="Orders Output"
           style="-fx-font-size: 14px; -fx-font-weight: bold;" />

    <TextArea fx:id="ordersArea"
              prefHeight="260"
              prefWidth="380"
              wrapText="true"/>

    <Separator/>

    <!-- EXIT -->
    <Button text="Exit"
            onAction="#exit"
            prefWidth="380"
            minWidth="380"
            maxWidth="380"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" />

</VBox>