<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0"
      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.DeptManagerApproveRejectPanelController">

    <Label text="Approve / Reject Requests"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    <Label text="Select a pending request and approve or reject it."
           style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />

    <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS"
               style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5;">
        <columns>
            <TableColumn fx:id="colRequestId" text="Request ID" prefWidth="90.0" />
            <TableColumn fx:id="colParkId" text="Park ID" prefWidth="80.0" />
            <TableColumn fx:id="colType" text="Type" prefWidth="130.0" />
            <TableColumn fx:id="colOldValue" text="Old Value" prefWidth="100.0" />
            <TableColumn fx:id="colNewValue" text="New Value" prefWidth="100.0" />
            <TableColumn fx:id="colStatus" text="Status" prefWidth="100.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="Refresh" onAction="#refreshRequests"
                prefHeight="35.0" prefWidth="100.0"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />

        <Button text="Approve" onAction="#approveRequest"
                prefHeight="35.0" prefWidth="110.0"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />

        <Button text="Reject" onAction="#rejectRequest"
                prefHeight="35.0" prefWidth="110.0"
                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="statusLabel"
               style="-fx-text-fill: #c0392b; -fx-font-size: 13px; -fx-font-weight: bold;" />
    </HBox>

</VBox>