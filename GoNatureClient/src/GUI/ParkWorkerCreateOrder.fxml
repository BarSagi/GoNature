<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="550.0"
	spacing="15.0" style="-fx-background-color: #f4f7f6;"
	xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.ParkWorkerCreateOrderController">

	<padding>
		<Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
	</padding>

	<VBox alignment="CENTER" maxWidth="450.0" spacing="15.0"
		style="-fx-background-color: white; -fx-background-radius: 10;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);
                 -fx-padding: 30;">

		<Label text="Create Order for Visitor"
			style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
			<VBox.margin>
				<Insets bottom="5.0" />
			</VBox.margin>
		</Label>

		<Label text="Park Worker Order Creation"
			style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;">
			<VBox.margin>
				<Insets bottom="10.0" />
			</VBox.margin>
		</Label>

		<GridPane hgap="15.0" vgap="15.0">

			<Label text="Select Park:"
				style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"
				GridPane.columnIndex="0" GridPane.rowIndex="0" />
			<ComboBox fx:id="parkComboBox" prefWidth="220.0"
				prefHeight="35.0" promptText="Choose a Park..."
				GridPane.columnIndex="1" GridPane.rowIndex="0" />

			<Label text="Visitor ID:" GridPane.columnIndex="0"
				GridPane.rowIndex="1" />
			<TextField fx:id="visitorIdField" prefWidth="220.0"
				prefHeight="35.0" promptText="Enter ID" GridPane.columnIndex="1"
				GridPane.rowIndex="1" />

			<Label text="Date:" GridPane.columnIndex="0"
				GridPane.rowIndex="2" />
			<DatePicker fx:id="visitDatePicker" prefWidth="220.0"
				prefHeight="35.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

			<Label text="Time:" GridPane.columnIndex="0"
				GridPane.rowIndex="3" />
			<ComboBox fx:id="timeComboBox" prefWidth="220.0"
				prefHeight="35.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

			<Label text="Visitors:" GridPane.columnIndex="0"
				GridPane.rowIndex="4" />
			<TextField fx:id="visitorCountField" prefWidth="220.0"
				prefHeight="35.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

			<Label text="Payment Method:" GridPane.columnIndex="0"
				GridPane.rowIndex="6" />
			<ComboBox fx:id="paymentComboBox" prefWidth="220.0"
				prefHeight="35.0" promptText="Choose When to Pay"
				GridPane.columnIndex="1" GridPane.rowIndex="6" />

		</GridPane>

		<Label fx:id="statusLabel"
			style="-fx-font-size: 14px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;" />

		<HBox alignment="CENTER" spacing="20.0">
			<Button text="Submit Order" onAction="#submitOrder"
				prefHeight="55.0" prefWidth="280.0"
				style="-fx-background-color: #27ae60;
                           -fx-background-radius: 30;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 16px;
                           -fx-cursor: hand;" />
		</HBox>

	</VBox>
</VBox>