<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="500.0"
      spacing="15.0" style="-fx-background-color: #f4f7f6;"
      xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.ParkWorkerCreateOrderController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Create Order for Visitor"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <Label text="Park Worker Order Creation"
           style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;">
        <VBox.margin>
            <Insets bottom="10.0"/>
        </VBox.margin>
    </Label>

    <ComboBox fx:id="parkComboBox" promptText="Choose a Park..."
              prefHeight="40.0" prefWidth="250.0" />

    <DatePicker fx:id="visitDatePicker"
                prefHeight="40.0" prefWidth="250.0" />

    <ComboBox fx:id="timeComboBox" promptText="Select Time..."
              prefHeight="40.0" prefWidth="250.0" />

    <TextField fx:id="visitorCountField" promptText="Number of people"
               prefHeight="40.0" prefWidth="250.0" />

    <TextField fx:id="emailField" promptText="example@mail.com"
               prefHeight="40.0" prefWidth="250.0" />

    <TextField fx:id="visitorIdField" promptText="Visitor ID"
               prefHeight="40.0" prefWidth="250.0" />

    <Button text="Submit Order"
            prefHeight="40.0" prefWidth="250.0"
            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
            onAction="#submitOrder" />

    <Button text="Back"
            prefHeight="35.0" prefWidth="120.0"
            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
            onAction="#goBack" />

    <Label fx:id="statusLabel" text=""
           style="-fx-text-fill: red; -fx-font-size: 14px;" />

</VBox>