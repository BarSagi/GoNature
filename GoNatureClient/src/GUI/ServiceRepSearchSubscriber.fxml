<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="450.0"
	spacing="20.0" style="-fx-background-color: #f4f4f4;"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.ServiceRepSearchSubscriberController">

	<children>
		<VBox alignment="CENTER" maxWidth="500.0" spacing="20.0"
			style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 5); -fx-padding: 30;">
			<children>

				<Label text="Search Subscriber" textFill="#2c3e50">
					<font>
						<Font name="System Bold" size="24.0" />
					</font>
				</Label>

				<HBox alignment="CENTER" spacing="10.0">
					<TextField fx:id="subscriberIdField"
						promptText="Enter Subscriber ID" prefWidth="220.0" />

					<Button text="Search" onAction="#searchSubscriber"
						style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
				</HBox>

				<GridPane hgap="15.0" vgap="15.0">
					<children>

						<Label text="Subscriber ID:" GridPane.columnIndex="0"
							GridPane.rowIndex="0" />
						<Label fx:id="idLabel" text="-" prefWidth="220.0"
							prefHeight="30.0"
							style="-fx-background-color: white; -fx-border-color: #bdbdbd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
							GridPane.columnIndex="1" GridPane.rowIndex="0" />

						<Label text="First Name:" GridPane.columnIndex="0"
							GridPane.rowIndex="1" />
						<Label fx:id="firstNameLabel" text="-" prefWidth="220.0"
							prefHeight="30.0"
							style="-fx-background-color: white; -fx-border-color: #bdbdbd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
							GridPane.columnIndex="1" GridPane.rowIndex="1" />

						<Label text="Last Name:" GridPane.columnIndex="0"
							GridPane.rowIndex="2" />
						<Label fx:id="lastNameLabel" text="-" prefWidth="220.0"
							prefHeight="30.0"
							style="-fx-background-color: white; -fx-border-color: #bdbdbd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
							GridPane.columnIndex="1" GridPane.rowIndex="2" />

						<Label text="Phone:" GridPane.columnIndex="0"
							GridPane.rowIndex="3" />
						<Label fx:id="phoneLabel" text="-" prefWidth="220.0"
							prefHeight="30.0"
							style="-fx-background-color: white; -fx-border-color: #bdbdbd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
							GridPane.columnIndex="1" GridPane.rowIndex="3" />

						<Label text="Email:" GridPane.columnIndex="0"
							GridPane.rowIndex="4" />
						<Label fx:id="emailLabel" text="-" prefWidth="220.0"
							prefHeight="30.0"
							style="-fx-background-color: white; -fx-border-color: #bdbdbd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
							GridPane.columnIndex="1" GridPane.rowIndex="4" />

						<Label text="Visitor Type:" GridPane.columnIndex="0"
							GridPane.rowIndex="5" />
						<Label fx:id="typeLabel" text="-" prefWidth="220.0"
							prefHeight="30.0"
							style="-fx-background-color: white; -fx-border-color: #bdbdbd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
							GridPane.columnIndex="1" GridPane.rowIndex="5" />

						<Label text="Subscription Number:" GridPane.columnIndex="0"
							GridPane.rowIndex="6" />
						<Label fx:id="subscriptionNumberLabel" text="-"
							prefWidth="220.0" prefHeight="30.0"
							style="-fx-background-color: white; -fx-border-color: #bdbdbd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
							GridPane.columnIndex="1" GridPane.rowIndex="6" />

						<Label text="Family Members:" GridPane.columnIndex="0"
							GridPane.rowIndex="7" />
						<Label fx:id="familyMembersLabel" text="-" prefWidth="220.0"
							prefHeight="30.0"
							style="-fx-background-color: white; -fx-border-color: #bdbdbd; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6;"
							GridPane.columnIndex="1" GridPane.rowIndex="7" />

					</children>
				</GridPane>

			</children>
		</VBox>
	</children>
</VBox>