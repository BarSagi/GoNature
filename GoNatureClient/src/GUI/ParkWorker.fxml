<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="500.0"
      spacing="15.0" style="-fx-background-color: #f4f7f6;"
      xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.ParkWorkerController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Park Worker Portal"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
	<Label fx:id="welcomeLabel" text="Welcome!"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2980b9;" />
    <Label fx:id="parkNameLabel" text="Park: Loading..."
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
    <Label text="Choose an action"
           style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;">
        <VBox.margin>
            <Insets bottom="10.0"/>
        </VBox.margin>
    </Label>

    <Button text="Create Order"
            prefHeight="40.0" prefWidth="250.0"
            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
            onAction="#createOrder" />

    <Button text="View Orders"
            prefHeight="40.0" prefWidth="250.0"
            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
            onAction="#viewOrders" />

    <Button text="Enter Visitor to Park"
            prefHeight="40.0" prefWidth="250.0"
            style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
            onAction="#enterVisitor" />

    <Button text="Exit Visitor from Park"
            prefHeight="40.0" prefWidth="250.0"
            style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
            onAction="#exitVisitor" />

    <Button text="Back"
            prefHeight="35.0" prefWidth="120.0"
            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
            onAction="#goBack">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Button>

</VBox>