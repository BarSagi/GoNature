<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="700.0" spacing="15.0"
	style="-fx-background-color: #f4f7f6; -fx-padding: 20;"
	xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.VisitorOrdersScreenController">

	<BorderPane>
		<left>
			<Label text="GoNature - Your Orders Hub"
				style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
				BorderPane.alignment="CENTER" />
		</left>
		<right>
			<Button text="Logout" onAction="#logout" prefHeight="30.0"
				prefWidth="100.0"
				style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
				BorderPane.alignment="CENTER" />
		</right>
	</BorderPane>

	<TableView fx:id="ordersTable" VBox.vgrow="ALWAYS"
		style="-fx-font-size: 14px; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5;">
		<columns>
			<TableColumn fx:id="colId" prefWidth="80.0"
				text="Order ID" />
			<TableColumn fx:id="colDate" prefWidth="100.0"
				text="Date" />
			<TableColumn fx:id="colTime" prefWidth="90.0" text="Time" />
			<TableColumn fx:id="colVisitors" prefWidth="90.0"
				text="Visitors" />
			<TableColumn fx:id="colType" prefWidth="120.0"
				text="Order Type" />
			<TableColumn fx:id="colStatus" prefWidth="120.0"
				text="Status" />
		</columns>
	</TableView>

	<HBox alignment="CENTER_RIGHT">
		<Button text="Create New Order" onAction="#createNewOrder"
			prefHeight="40.0" prefWidth="200.0"
			style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
	</HBox>
</VBox>