<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="450.0"
	spacing="20.0" style="-fx-background-color: #f4f7f6;"
	xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.LoginVisitorController">

	<padding>
		<Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
	</padding>

	<Label text="Visitor Identification"
		style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

	<Label text="Please enter your ID number to continue"
		style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />

	<TextField fx:id="idField" maxWidth="250.0" prefHeight="40.0"
		promptText="e.g., 123456789"
		style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-font-size: 16px; -fx-alignment: center;" />

	<Label fx:id="errorLabel"
       visible="false"
       style="-fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-font-weight: bold;" />

	<Button text="Login / Enter" onAction="#loginVisitor"
		prefHeight="40.0" prefWidth="250.0"
		style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15px;" />

	<Button text="Back" onAction="#goBack" prefHeight="35.0"
		prefWidth="100.0"
		style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 13px;" />

</VBox>