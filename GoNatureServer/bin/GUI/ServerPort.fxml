<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="550.0"
	spacing="15.0"
	style="-fx-background-color: #f4f7f6; -fx-border-color: #dcdde1; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;"
	xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="GUI.ServerPortFrameController">

	<padding>
		<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
	</padding>

	<Label text="GoNature Server Console"
		style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

	<Label text="Enter Server Port:"
		style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />

	<TextField fx:id="portxt" alignment="CENTER" maxWidth="250.0"
		prefHeight="35.0" promptText="e.g. 5555"
		style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-font-size: 14px;" />

	<Button text="Start Server" onAction="#done" prefHeight="35.0"
		prefWidth="250.0"
		style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

	<Button text="Show Connected Clients" onAction="#showClients"
		prefHeight="35.0" prefWidth="250.0"
		style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

	<VBox spacing="5" alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
		<Label text="Server Log:"
			style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
		<TextArea fx:id="logArea" editable="false" wrapText="false"
			VBox.vgrow="ALWAYS"
			style="-fx-control-inner-background: #1e1e1e; -fx-text-fill: #4cd137; -fx-font-family: 'Consolas'; -fx-border-color: #2c3e50; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-size: 13px;" />
	</VBox>

	<Button text="Stop &amp; Exit" onAction="#exit"
		prefHeight="35.0" prefWidth="250.0"
		style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

</VBox>